# Google sign-in (Gmail, Drive, Sheets). Create a "Desktop app" OAuth client at
# https://console.cloud.google.com/apis/credentials and enable the Gmail, Drive
# and Sheets APIs. Copy this file to .env and fill these in. .env is git-ignored.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dropbox (a Folder Frenzy cabinet). Create an app at
# https://www.dropbox.com/developers/apps with "Scoped access", then either
# "Full Dropbox" (to sort a folder you already have, e.g. --dropbox-folder /Downloads)
# or "App folder" (ChoreCade only ever sees /Apps/<app name>).
#   Permissions tab: tick files.metadata.read and files.content.write
#     (account_info.read is always on), then Submit.
#   Settings tab: add the redirect URI http://127.0.0.1:4747/oauth/dropbox/callback
#     (use your --port instead of 4747), and leave "Allow public clients" on Allow.
# Only the App key goes here: ChoreCade signs in with PKCE and needs no app secret.
DROPBOX_APP_KEY=

# Optional: Claude suggestions with --ai
# ANTHROPIC_API_KEY=
